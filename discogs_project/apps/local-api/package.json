{
  "name": "discogs-local-api",
  "version": "1.0.0",
  "description": "Local Discogs collection REST API (Fastify + pg)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "migrate": "tsx scripts/migrate.ts",
    "smoke:http": "tsx scripts/smoke-http.ts"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/static": "^7.0.4",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "fastify": "^4.27.0",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
