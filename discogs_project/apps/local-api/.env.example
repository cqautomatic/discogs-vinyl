# Local API environment variables
# Copy to .env and fill in values before running

# PostgreSQL connection — must match docker-compose.yml and root .env.example
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=discogs_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DATABASE=discogs_collection
POSTGRES_SCHEMA=collection_data

# API server
PORT=3001

# CORS: set to the React dev server origin
CORS_ORIGIN=http://localhost:5173
