# Copy this file to .env and fill in real values.
# Never commit .env — it contains secrets.
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values
#   docker compose up -d postgres

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# These values must match what was used in docker-compose.yml / your local PG instance.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=discogs_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=discogs_collection
# Also exported as POSTGRES_DATABASE for Python config compatibility:
POSTGRES_DATABASE=discogs_collection
POSTGRES_SCHEMA=collection_data

# ── Discogs API ─────────────────────────────────────────────────────────────────
# Generate a personal access token at: Settings → Developers → Generate new token
DISCOGS_TOKEN=your_discogs_token_here
DISCOGS_USERNAME=your_discogs_username
DISCOGS_USER_AGENT=DiscogsCollectionDownloader/1.0

# ── Artwork (optional) ─────────────────────────────────────────────────────────
# Local path where downloaded artwork images are stored.
LOCAL_ARTWORK_PATH=./artwork

# ── Rate limiting (optional) ───────────────────────────────────────────────────
# Seconds between Discogs API requests. 1.0 is safe; lower may hit rate limits.
DISCOGS_RATE_LIMIT_DELAY=1.0
