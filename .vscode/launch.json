{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Snowflake Script",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Snowflake Connection Test",
            "type": "python",
            "request": "launch",
            "program": "snowflake_pat_setup.py",
            "args": ["test"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
